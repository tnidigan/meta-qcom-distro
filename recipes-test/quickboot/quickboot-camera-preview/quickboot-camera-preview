# QuickBoot CAMX camera preview reference application using GStreamer.
# The application is a test vehicle for camera readiness measurements. It
# renders a live preview from the CAMX pipeline via qtiqmmfsrc directly to
# the Linux framebuffer (fbdevsink), so it has no Weston/Wayland dependency.
# It can be run directly or through its opt-in systemd unit.

set -eu

APP_NAME="quickboot-camera-preview"

CAMERA_FORMAT="${CAMERA_FORMAT:-NV12_Q08C}"
CAMERA_WIDTH="${CAMERA_WIDTH:-1920}"
CAMERA_HEIGHT="${CAMERA_HEIGHT:-1080}"
CAMERA_FRAMERATE="${CAMERA_FRAMERATE:-30/1}"
CAMERA_CAPS="video/x-raw,format=${CAMERA_FORMAT},width=${CAMERA_WIDTH},height=${CAMERA_HEIGHT},framerate=${CAMERA_FRAMERATE}"

PREVIEW_SINK_FORMAT="${PREVIEW_SINK_FORMAT:-BGRx}"
PREVIEW_FB_DEVICE="${PREVIEW_FB_DEVICE:-/dev/fb0}"

log_message() {
    level="$1"
    message="$2"
    printf '[%s] %s: %s\n' "$level" "$APP_NAME" "$message"
}

log_message "INFO" "QuickBoot CAMX Camera Preview Test Started"
log_message "INFO" "Capturing with ${CAMERA_CAPS}"
log_message "INFO" "Rendering to ${PREVIEW_FB_DEVICE} (format=${PREVIEW_SINK_FORMAT})"

# Replace the shell process so signals from the test harness or systemd reach
# gst-launch directly.
exec env GST_REGISTRY_UPDATE=no gst-launch-1.0 -e \
    qtiqmmfsrc name=camsrc video_0::type=preview \
    ! "${CAMERA_CAPS}" \
    ! qtivtransform \
    ! "video/x-raw,format=${PREVIEW_SINK_FORMAT}" \
    ! fbdevsink device="${PREVIEW_FB_DEVICE}"
